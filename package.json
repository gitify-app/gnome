{
  "name": "@gitify-app/gnome",
  "version": "0.2.0",
  "private": true,
  "description": "GNOME Shell extension that anchors the Gitify window to its tray icon",
  "homepage": "https://gitify.io/",
  "bugs": {
    "url": "https://github.com/gitify-app/gnome/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitify-app/gnome.git"
  },
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules --test tests/*.test.js",
    "test:shell": "bash scripts/test-shell.sh",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint --fix",
    "lint:check": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "bundle": "scripts/bundle.sh"
  },
  "devDependencies": {
    "vite-plus": "0.3.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.9.0"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1"
}
