{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>gitify-app/.github"],
  "packageRules": [
    {
      "description": "Keep the supported Node range separate from the development runtime pin.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "rangeStrategy": "widen"
    }
  ]
}
